# ============================================
# Privacy Guard MCP - 環境変数の例
# ============================================
# このファイルをコピーして .env を作り、必要な値だけ設定する。
# .env は Git にコミットしない（.gitignore で除外済み）。
# 値は MCP の登録時に env として渡してもよい（README の「設定」を参照）。

# ログレベル: DEBUG / INFO / WARNING / ERROR（既定: INFO）
LOG_LEVEL=INFO

# フェイルクローズ: true=マスク失敗時にデータを遮断（既定・本番では必須）
# false=デバッグ用のみ
FAIL_CLOSE=true

# gws / gog コマンドのパス（Google Workspace を読む場合のみ）
# 省略時は PATH から探す。PATH に無い場所に入れた場合は絶対パスを指定する
# PRIVACY_GUARD_GWS_COMMAND=
# PRIVACY_GUARD_GOG_COMMAND=
